INMYAI_API_URL=http://127.0.0.1:8000
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
INMYAI_DATA_DIR=./data/runtime
INMYAI_WORKSPACE_ROOT=./workspace
INMYAI_ALLOW_ANY_LOCAL_PATH=false
# Windows example: C:\\dev;D:\\work — use the OS path separator (; on Windows, : on Linux/macOS)
INMYAI_ALLOWED_ROOTS=
INMYAI_MAX_FILE_MB=2
INMYAI_MAX_INDEX_FILES=5000
INMYAI_PROVIDER=mock
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=gemma3:4b
COMFYUI_BASE_URL=http://127.0.0.1:8188
COMFYUI_WORKFLOW_PATH=
INMYAI_IDLE_MODEL_TIMEOUT_SECONDS=300
