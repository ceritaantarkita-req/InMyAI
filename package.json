{
  "name": "inmyai",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/web"
  ],
  "scripts": {
    "dev:web": "npm --workspace apps/web run dev",
    "build:web": "npm --workspace apps/web run build",
    "typecheck:web": "npm --workspace apps/web run typecheck",
    "test:web": "npm --workspace apps/web run test",
    "dev:api": "python -m uvicorn services.api.app.main:app --reload --host 127.0.0.1 --port 8000",
    "test:api": "python -m pytest services/api/tests -q",
    "setup": "node scripts/setup.mjs",
    "dev": "node scripts/dev.mjs",
    "qa": "node scripts/qa.mjs",
    "desktop:dev": "npm run tauri --workspace apps/web -- dev",
    "desktop:build": "npm run tauri --workspace apps/web -- build"
  },
  "overrides": {
    "next": {
      "postcss": "8.5.20"
    }
  }
}
